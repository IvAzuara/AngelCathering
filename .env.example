# ==========================================
# Configuración de Base de Datos (Supabase PostgreSQL)
# ==========================================
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your-supabase-db-password

# Cadena de conexión completa para Flyway
FLYWAY_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require
FLYWAY_USER=${DB_USER}
FLYWAY_PASSWORD=${DB_PASSWORD}

# Cadena de conexión para .NET
CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true;

# ==========================================
# Frontend (Vite)
# ==========================================
VITE_API_URL=http://localhost:5000
