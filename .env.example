# ─── Base de datos (servidor PostgreSQL local o Supabase) ───
DB_HOST=localhost
DB_PORT=5433
DB_NAME=angel_catering
DB_USER=postgres
DB_PASSWORD=root
DB_TIMEZONE=America/Mexico_City

# Cadena de conexión para .NET
CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};

# ─── Supabase Storage (Almacenamiento de imágenes del menú) ─────────────
SUPABASE_URL=https://zbjztvtagkorxejxvyjz.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_role_key
SUPABASE_BUCKET=menu-images

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=AngelCathering_SuperSecret_Jwt_Key_2026_Development_Key_Min32Chars!
JWT_ISSUER=angelcathering-api

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5130
